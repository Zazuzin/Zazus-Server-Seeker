{
  "schemaVersion": 1,
  "id": "zazus-server-tool",
  "version": "${version}",
  "name": "Zazu's Server Seeker",
  "description": "Client-side Minecraft server discovery and management with categories, favourites, verified scanning, sequential Auto Join, deletion recovery and optional ViaFabricPlus integration.",
  "authors": ["Zazuzin"],
  "icon": "assets/zazus-server-tool/icon.png",
  "contact": {
    "homepage": "https://github.com/Zazuzin/Zazus-Server-Scanner",
    "sources": "https://github.com/Zazuzin/Zazus-Server-Scanner",
    "issues": "https://github.com/Zazuzin/Zazus-Server-Scanner/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.zazuzin.zst.MultiplayerManagementEntrypoint",
      "dev.zazuzin.zst.WhitelistAutoDeleteEntrypoint",
      "dev.zazuzin.zst.AutoJoinEntrypoint",
      "dev.zazuzin.zst.TitleCreditEntrypoint",
      "dev.zazuzin.zst.ServerTabsEntrypoint"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "fabric-api": "*",
    "java": ">=21"
  },
  "suggests": {
    "viafabricplus": ">=4.6.1"
  }
}
